{
  "permissions": {
    "allow": [
      "Bash(node:*)",
      "Bash(npm:*)",
      "Bash(npx --version)",
      "Bash(docker:*)",
      "Bash(docker compose:*)",
      "WebSearch",
      "WebFetch(domain:ui.nuxt.com)",
      "Bash(git init:*)",
      "Bash(curl:*)",
      "Bash(MSYS_NO_PATHCONV=1 docker exec:*)",
      "Bash(git add:*)",
      "mcp__nuxt-ui-remote__get-component",
      "Bash(cd:*)",
      "mcp__nuxt-ui-remote__get-documentation-page"
    ],
    "deny": [
      "Bash(rm:*)"
    ],
    "defaultMode": "acceptEdits"
  }
}
